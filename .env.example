# CA Configuration
CA_ORGANIZATION=Cislunar Certificate Authority
CA_COUNTRY=US
CA_KEY_TYPE=ecdsa-p256

# Storage
CA_DUCKDB_PATH=/data/ca/ca.db
CA_CHROMA_HOST=localhost
CA_CHROMA_PORT=8000

# AI
CA_OLLAMA_HOST=http://localhost:11434
CA_OLLAMA_MODEL=llama3.2:3b

# Observability
CA_WEAVE_PROJECT=cislunar-ca
CA_WEAVE_ENABLED=true

# Security
JWT_SECRET=change-me-in-production
CA_API_KEY=change-me-in-production

# Server
CA_GRPC_ADDR=[::1]:50051
CA_API_ADDR=http://localhost:8080
